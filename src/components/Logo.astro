---
import Bloombit from "../../public/projects/bloombit.svg";
import Clayo from "../../public/projects/clayo.svg";
import Finance from "../../public/projects/manavalan-finance.svg";
import Snorlax from "../../public/projects/snorlax.svg";
import Heartbeat from "../../public/projects/heartbeat.svg";

interface Props {
  src: string;
  alt?: string;
  width: string | number;
  height: string | number;
  class?: string;
  loading?: "lazy" | "eager";
}

const { src, alt = "", width, height, class: className, loading } = Astro.props;
const vectors: Record<string, typeof Bloombit> = {
  "/projects/bloombit.svg": Bloombit,
  "/projects/clayo.svg": Clayo,
  "/projects/manavalan-finance.svg": Finance,
  "/projects/snorlax.svg": Snorlax,
  "/projects/heartbeat.svg": Heartbeat,
};
const Vector = vectors[src];
---

{Vector ? (
  <Vector width={width} height={height} class={className}
    aria-hidden={alt ? undefined : "true"} role={alt ? "img" : undefined}
    aria-label={alt || undefined} focusable="false" />
) : (
  <img src={src} alt={alt} width={width} height={height} class={className} loading={loading} />
)}
