---
import VentureCard from "./VentureCard.astro";
---

<section aria-label="Ventures">
  <ul class="continuous-list space-y-3 reveal-list [--item-gap:12px]">
    <VentureCard
      name="Anton Video"
      description="AI video editor"
      url="https://antonvideo.app"
      logo="/projects/anton.webp"
    />
    <VentureCard
      name="Bloombit"
      description="AI book summary app"
      logo="/projects/bloombit.svg"
      archived
    />
    <VentureCard
      name="Clayo AI"
      description="AI call screener"
      url="https://clayo.ai"
      logo="/projects/clayo.svg"
    />
    <VentureCard
      name="Hyfic"
      description="Software agency"
      url="https://hyfic.org"
      logo="/venture/hyfic.png"
    />
  </ul>
</section>
