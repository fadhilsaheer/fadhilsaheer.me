---
interface Props {
  direction?: "external" | "back";
  class?: string;
  strokeWidth?: number;
}

const {
  direction = "external",
  class: className = "size-3.5",
  strokeWidth = 1.25,
} = Astro.props;
---

<svg
  class={className}
  width="16"
  height="16"
  viewBox="0 0 16 16"
  fill="none"
  aria-hidden="true"
>
  {direction === "back" ? (
    <path
      d="M12.5 3v4a3 3 0 0 1-3 3h-7M5.5 7l-3 3 3 3"
      stroke="currentColor"
      stroke-width={strokeWidth}
      stroke-linecap="round"
      stroke-linejoin="round"
    />
  ) : (
    <path
      d="M4 12 12 4M4.5 4H12v7.5"
      stroke="currentColor"
      stroke-width={strokeWidth}
      stroke-linecap="round"
      stroke-linejoin="round"
    />
  )}
</svg>
