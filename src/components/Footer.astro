<footer
  style="--reveal-delay: 240ms"
  class="reveal mt-auto flex flex-wrap items-center justify-between gap-x-6 gap-y-3 pt-20 text-xs leading-normal text-subtle"
>
  <local-clock class="flex items-center gap-1">
    <time class="inline-flex shrink-0 whitespace-nowrap tabular-nums">
      <span data-readable-time class="sr-only">Loading local time</span>
      {Array.from("--:--:--", (character) => (
        <span aria-hidden="true" class={character === ":" ? "inline-block w-[0.24em] text-center" : "inline-block w-[0.6em] text-center"}>
          {character}
        </span>
      ))}
    </time>
    <span data-timezone-diff></span>
  </local-clock>
  <a href="/" class="transition-colors duration-200 hover:text-heading">
    fadhilsaheer.me
  </a>
</footer>

<script>
  class LocalClock extends HTMLElement {
    private timer?: ReturnType<typeof setInterval>;

    connectedCallback() {
      const time = this.querySelector("time");
      const digits = time?.querySelectorAll("span[aria-hidden]");
      const readableTime = time?.querySelector("[data-readable-time]");
      const timezoneDiff = this.querySelector("[data-timezone-diff]");
      if (!time || !digits || !timezoneDiff || !readableTime) return;
      const format = new Intl.DateTimeFormat("en-GB", {
        timeZone: "Asia/Kolkata",
        hour: "2-digit",
        minute: "2-digit",
        second: "2-digit",
        hour12: false,
      });
      const update = () => {
        const now = new Date();
        time.dateTime = now.toISOString();
        const formattedTime = format.format(now);
        readableTime.textContent = `${formattedTime} in Kolkata`;
        digits.forEach((digit, index) => {
          digit.textContent = formattedTime[index];
        });
        // Kolkata is UTC+05:30; getTimezoneOffset is UTC minus local time.
        const differenceHours = (330 + now.getTimezoneOffset()) / 60;
        timezoneDiff.textContent = differenceHours === 0
          ? "(same time)"
          : `(${differenceHours > 0 ? "+" : ""}${differenceHours}h)`;
      };
      update();
      this.timer = setInterval(update, 1000);
    }

    disconnectedCallback() {
      clearInterval(this.timer);
    }
  }

  if (!customElements.get("local-clock"))
    customElements.define("local-clock", LocalClock);
</script>
