<footer class="mt-auto flex flex-wrap items-center justify-between gap-x-6 gap-y-3 pt-20 text-xs leading-normal text-subtle">
  <div class="flex items-center gap-2">
    <span class="size-1 rounded-full bg-subtle/40" aria-hidden="true"></span>
    <local-clock class="tabular-nums">
      <time>--:--:--</time>
    </local-clock>
    <span>India</span>
  </div>
  <a href="/" class="transition-colors duration-200 hover:text-heading">
    fadhilsaheer.me
  </a>
</footer>

<script>
  class LocalClock extends HTMLElement {
    private timer?: ReturnType<typeof setInterval>;

    connectedCallback() {
      const time = this.querySelector("time");
      if (!time) return;
      const format = new Intl.DateTimeFormat("en-GB", {
        timeZone: "Asia/Kolkata",
        hour: "2-digit",
        minute: "2-digit",
        second: "2-digit",
        hour12: false,
      });
      const update = () => {
        const now = new Date();
        time.dateTime = now.toISOString();
        time.textContent = format.format(now);
      };
      update();
      this.timer = setInterval(update, 1000);
    }

    disconnectedCallback() {
      clearInterval(this.timer);
    }
  }

  if (!customElements.get("local-clock"))
    customElements.define("local-clock", LocalClock);
</script>
