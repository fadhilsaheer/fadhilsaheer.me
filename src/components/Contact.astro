---
import ContactCard from "./ContactCard.astro";
import EmailCopy from "./EmailCopy.astro";
---

<section aria-label="Contact links">
  <p class="reveal mb-7 text-muted" style="--reveal-delay: 40ms">
    You can reach me at <EmailCopy />, or find me here.
  </p>
  <ul class="continuous-list space-y-1 reveal-list [--item-gap:4px]">
    <ContactCard
      name="Email"
      url="mailto:fadhil@hyfic.org"
      value="fadhil@hyfic.org"
    />
    <ContactCard
      name="Book a call"
      url="https://cal.com/fadhilsaheer"
      value="cal.com/fadhilsaheer"
    />
    <ContactCard
      name="LinkedIn"
      url="https://www.linkedin.com/in/fadhilsaheer/"
      value="/in/fadhilsaheer"
    />
    <ContactCard
      name="GitHub"
      url="https://github.com/fadhilsaheer"
      value="@fadhilsaheer"
    />
    <ContactCard
      name="X"
      url="https://x.com/fadhilsaheer"
      value="@fadhilsaheer"
    />
    <ContactCard
      name="Telegram"
      url="https://t.me/fadhilsaheer"
      value="@fadhilsaheer"
    />
  </ul>
</section>
