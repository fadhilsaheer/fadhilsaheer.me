---
import Logo from "../Logo.astro";
import Arrow from "../Arrow.astro";
import AntonPreview from "./previews/AntonPreview.astro";
import BloombitPreview from "./previews/BloombitPreview.astro";
import ClayoPreview from "./previews/ClayoPreview.astro";
import SnorlaxPreview from "./previews/SnorlaxPreview.astro";

import FinancePreview from "./previews/FinancePreview.astro";
import LogHorizonPreview from "./previews/LogHorizonPreview.astro";

const previews = {
  finance: FinancePreview,
  logHorizon: LogHorizonPreview,
  anton: AntonPreview,
  bloombit: BloombitPreview,
  clayo: ClayoPreview,
  snorlax: SnorlaxPreview,
};

interface Props {
  title: string;
  description: string;
  url: string;
  year: string;
  preview: keyof typeof previews;
  logo: string;
}

const { title, description, url, year, preview, logo } = Astro.props;
const Preview = previews[preview];
---

<li class="reveal min-w-0">
  <a
    href={url}
    target="_blank"
    rel="noopener noreferrer"
    class="project-card group relative block h-full"
  >
    <div class="aspect-[5/4] overflow-hidden rounded-[10px] bg-[#f6f6f6]">
      <Preview />
    </div>
    <div class="mt-2 flex items-start justify-between gap-2">
      <h2 class="flex min-w-0 items-start gap-1.5 font-medium text-heading">
        <Logo
          src={logo}
          alt=""
          width="16"
          height="16"
          class="mt-1 size-4 shrink-0 rounded-[4px] object-contain grayscale transition-[filter] duration-300 ease-out group-hover:grayscale-0 group-focus-visible:grayscale-0"
          loading="lazy"
        />
        <span>{title}</span>
      </h2>
      <span class="relative mt-1 block h-4 shrink-0 overflow-hidden text-xs tabular-nums text-subtle">
        <span class="block leading-4 transition-transform duration-300 ease-out-soft group-hover:-translate-y-full group-focus-visible:-translate-y-full">
          {year}
        </span>
        <span
          aria-hidden="true"
          class="absolute inset-0 flex translate-y-full items-center justify-end transition-transform duration-300 ease-out-soft group-hover:translate-y-0 group-focus-visible:translate-y-0"
        >
          <Arrow class="size-3" strokeWidth={1.8} />
        </span>
      </span>
    </div>
    <p class="mt-1 text-[13px] leading-relaxed text-muted">{description}</p>
  </a>
</li>
