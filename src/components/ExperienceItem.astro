---
import ExternalLink from "./ExternalLink.astro";
interface Props {
  period: string;
  title: string;
  company: string;
  companyUrl: string;
  companyLogo: string;
  description: string;
}

const { period, title, company, companyUrl, companyLogo, description } =
  Astro.props;
---

<li class="reveal">
  <p class="mb-2 text-xs tabular-nums text-subtle">{period}</p>
  <h2 class="font-medium text-heading">
    {title} at{" "}
    <ExternalLink href={companyUrl}>
      <img
        src={companyLogo}
        alt=""
        width="18"
        height="18"
        class="mx-1 inline size-[18px] rounded align-[-3px]"
        loading="lazy"
      />
      {company}
    </ExternalLink>
  </h2>
  <p class="mt-2 text-muted">{description}</p>
</li>
