---
import Arrow from "./Arrow.astro";

interface Props {
  name: string;
  description: string;
  url: string;
  logo: string;
  logoAlt?: string;
}

const { name, description, url, logo, logoAlt = "" } = Astro.props;
---

<li class="reveal">
  <a
    href={url}
    target="_blank"
    rel="noopener noreferrer"
    class="list-link group flex items-center gap-4"
  >
    <img
      src={logo}
      alt={logoAlt}
      width="36"
      height="36"
      class="size-9 shrink-0 rounded-lg"
      loading="lazy"
    />
    <div class="min-w-0 flex-1">
      <h2 class="font-medium text-heading">{name}</h2>
      <p class="text-muted">{description}</p>
    </div>
    <Arrow class="size-3.5 shrink-0 text-subtle transition-transform duration-200 group-hover:-translate-y-0.5 group-hover:translate-x-0.5" />
  </a>
</li>
