---
import Arrow from "./Arrow.astro";

interface Props {
  name: string;
  description: string;
  url?: string;
  logo: string;
  logoAlt?: string;
  archived?: boolean;
}

const { name, description, url, logo, logoAlt = "", archived = false } = Astro.props;
const Tag = url ? "a" : "div";
---

<li class="reveal">
  <Tag
    href={url}
    target={url ? "_blank" : undefined}
    rel={url ? "noopener noreferrer" : undefined}
    class:list={[
      "flex items-center gap-4",
      url ? "list-link group" : "-mx-3 px-3 py-3",
    ]}
  >
    <img
      src={logo}
      alt={logoAlt}
      width="36"
      height="36"
      class:list={["size-9 shrink-0 rounded-lg", { grayscale: archived }]}
      loading="lazy"
    />
    <div class="min-w-0 flex-1">
      <h2 class="font-medium text-heading">{name}</h2>
      <p class="text-muted">{description}</p>
    </div>
    {archived ? (
      <span class="shrink-0 text-xs text-subtle">Archived</span>
    ) : url && (
      <Arrow class="size-3.5 shrink-0 text-subtle transition-transform duration-200 group-hover:-translate-y-0.5 group-hover:translate-x-0.5" />
    )}
  </Tag>
</li>
