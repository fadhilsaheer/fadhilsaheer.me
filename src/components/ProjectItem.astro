---
import Arrow from "./Arrow.astro";

interface Props {
  url: string;
  title: string;
  description: string;
  platform: "WEB" | "MOBILE" | "DESKTOP";
  year: string;
}

const { url, title, description, platform, year } = Astro.props;
const platformLabel = platform.charAt(0) + platform.slice(1).toLowerCase();
---

<li class="reveal">
  <a
    href={url}
    target="_blank"
    rel="noopener noreferrer"
    class="list-link group"
  >
    <div class="flex items-baseline justify-between gap-4">
      <h2 class="flex items-center gap-1 font-medium text-heading">
        {title}
        <Arrow class="size-3 text-subtle transition-transform duration-200 group-hover:-translate-y-0.5 group-hover:translate-x-0.5" />
      </h2>
      <span class="shrink-0 text-xs tabular-nums text-subtle">{year}</span>
    </div>
    <p class="mt-1 text-muted">{description}</p>
    <p class="mt-1 text-xs text-subtle">{platformLabel}</p>
  </a>
</li>
