---
interface Props {
  url: string;
  title: string;
  description: string;
  platform: "WEB" | "MOBILE" | "DESKTOP";
  year: string;
  className?: string;
  containerClassName?: string;
}

const {
  url,
  title,
  description,
  platform,
  year,
  className,
  containerClassName,
} = Astro.props;
---

<a
  href={url}
  target="_blank"
  class={`block py-px hover:py-1 transition-all duration-300 ease-in-out ${className}`}
>
  <div
    class={`p-4 rounded hover:rounded-lg bg-macchiato-base hover:bg-macchiato-surface-0 transition-all duration-300 ease-in-out cursor-pointer flex justify-between ${containerClassName}`}
  >
    <div>
      <h3>{title}</h3>
      <p class="font-light text-sm text-macchiato-subtext-0">
        {description}
      </p>
    </div>
    <div class="text-right text-xs font-light font-geist-mono">
      <p class="text-macchiato-subtext-0">{platform}</p>
      <p class="text-macchiato-overlay-0">{year}</p>
    </div>
  </div>
</a>
