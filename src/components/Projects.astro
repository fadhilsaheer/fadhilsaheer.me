---
import ExternalLink from "./ExternalLink.astro";
import ProjectItem from "./ProjectItem.astro";
import ProjectCard from "./projects/ProjectCard.astro";
---

<section aria-label="Projects">
  <ul
    class="project-grid grid grid-cols-1 gap-x-4 gap-y-8 min-[360px]:grid-cols-2 reveal-list"
  >
    <ProjectCard
      url="https://antonvideo.app"
      title="Anton Video"
      logo="/projects/anton.webp"
      description="AI video editor."
      year="2026"
      preview="anton"
    />
    <ProjectCard
      url="https://hyfic.org/manavalan-finance/"
      title="Manavalan Finance"
      logo="/projects/manavalan-finance.svg"
      description="Offline finances."
      year="2026"
      preview="finance"
    />
    <ProjectCard
      url="https://apps.apple.com/in/app/bloombit-business-books-daily/id6752989502"
      title="Bloombit"
      logo="/projects/bloombit.svg"
      description="Book summaries."
      year="2025"
      preview="bloombit"
    />
    <ProjectCard
      url="https://clayo.ai"
      title="Clayo AI"
      logo="/projects/clayo.svg"
      description="AI call screening."
      year="2025"
      preview="clayo"
    />
    <ProjectCard
      url="https://hyfic.org/log-horizon/"
      title="Log Horizon"
      logo="/projects/log-horizon.webp"
      description="Private journaling."
      year="2026"
      preview="logHorizon"
    />
    <ProjectCard
      url="https://github.com/hyfic/snorlax"
      title="Snorlax"
      logo="/projects/snorlax.svg"
      description="Local cloud storage."
      year="2023"
      preview="snorlax"
    />
  </ul>
  <div class="mt-12">
    <h3
      class="reveal mb-4 font-medium text-heading"
      style="--reveal-delay: 320ms"
    >
      More projects
    </h3>
    <ul class="continuous-list space-y-2 reveal-list [--item-gap:8px]">
      <ProjectItem
        url="https://hyfic.org/openvia/"
        title="OpenVia"
        logo="/projects/openvia.webp"
        description="Browser routing for macOS."
        platform="DESKTOP"
        year="2026"
      />
      <ProjectItem
        url="https://octoi.github.io/heartbeat/"
        title="Heartbeat"
        logo="/projects/heartbeat.svg"
        description="Patient management."
        platform="DESKTOP"
        year="2022"
      />
    </ul>
  </div>
  <p class="reveal mt-8 text-muted" style="--reveal-delay: 360ms">
    More experiments on{" "}
    <ExternalLink href="https://github.com/octoi">GitHub</ExternalLink>.
  </p>
</section>
