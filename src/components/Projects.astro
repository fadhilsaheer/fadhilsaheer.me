---
import ProjectItem from "./ProjectItem.astro";
---

<section aria-label="Projects">
  <ul class="space-y-2 reveal-list">
    <ProjectItem
      url="https://getbloombit.com"
      title="Bloombit"
      description="AI book summary app."
      platform="MOBILE"
      year="2025"
    />
    <ProjectItem
      url="https://clayo.ai"
      title="Clayo AI"
      description="AI call screener."
      platform="MOBILE"
      year="2025"
    />
    <ProjectItem
      url="https://github.com/hyfic/snorlax"
      title="Snorlax"
      description="Local cloud storage."
      platform="DESKTOP"
      year="2023"
    />
    <ProjectItem
      url="https://octoi.github.io/heartbeat/"
      title="Heartbeat"
      description="Patient management system."
      platform="DESKTOP"
      year="2022"
    />
    <ProjectItem
      url="https://octoi.github.io/heartbeat/"
      title="Uchat"
      description="Chat app."
      platform="WEB"
      year="2021"
    />
  </ul>
  <p class="mt-8 text-muted">
    More experiments on{" "}
    <a
      class="text-link"
      href="https://github.com/octoi"
      target="_blank"
      rel="noopener noreferrer"
    >
      GitHub
    </a>
    .
  </p>
</section>
