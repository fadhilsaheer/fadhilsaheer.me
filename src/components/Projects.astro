---
import ProjectItem from "./ProjectItem.astro";
---

<section class="container">
  <div>
    <h3
      class="font-geist-mono font-light text-macchiato-subtext-0 text-xs tracking-wider"
    >
      PROJECTS
    </h3>
    <p class="mt-4 text-macchiato-subtext-0 font-light">
      Most of these projects never saw production, but they got pretty close.
      Every one of them helped me refine my process and build faster.
    </p>
  </div>

  <div class="mt-8 select-none font-light">
    <ProjectItem
      url="https://getbloombit.com"
      title="Bloombit"
      description="AI book summary app."
      platform="MOBILE"
      year="2025"
      className="block py-0 pb-px hover:py-0 hover:pb-1"
      containerClassName="rounded-none rounded-t-lg hover:rounded-b-lg"
    />

    <ProjectItem
      url="https://clayo.ai"
      title="Clayo AI"
      description="AI call screener"
      platform="MOBILE"
      year="2025"
    />

    <ProjectItem
      url="https://github.com/hyfic/snorlax"
      title="Snorlax"
      description="Local cloud storage"
      platform="DESKTOP"
      year="2023"
    />

    <ProjectItem
      url="https://octoi.github.io/heartbeat/"
      title="Heartbeat"
      description="Patient management system"
      platform="DESKTOP"
      year="2022"
    />

    <ProjectItem
      url="https://octoi.github.io/heartbeat/"
      title="Uchat"
      description="Chat app"
      platform="WEB"
      year="2021"
      className="block pt-px hover:pt-1 transition-all duration-300 ease-in-out"
      containerClassName="rounded-b-lg hover:rounded-lg"
    />
  </div>

  <div class="flex justify-end mt-5">
    <a
      href="https://github.com/octoi"
      target="_blank"
      class="text-xs cursor-pointer text-macchiato-subtext-0 hover:text-macchiato-text transition-all"
    >
      <span class="text-sm">/</span>projects
    </a>
  </div>
</section>
