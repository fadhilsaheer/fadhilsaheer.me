---
import Avatar from "./Avatar.astro";
import EmailCopy from "./EmailCopy.astro";
---

<section aria-labelledby="intro-title">
  <div class="-ml-6 mb-3 w-fit reveal">
    <Avatar />
  </div>

  <h1 id="intro-title" class="mb-6 font-medium text-heading reveal">
    Hi, I’m Fadhil.
  </h1>

  <div class="page-copy reveal-list">
    <p class="reveal">
      A design and full-stack engineer who loves turning ideas into real
      products. Building, learning, and experimenting with new tech keeps me
      going.
    </p>
    <p class="reveal">
      You can explore my{" "}
      <a class="text-link" href="/projects">
        projects
      </a>
      , follow my{" "}
      <a class="text-link" href="/experience">
        experience
      </a>
      , or meet the{" "}
      <a class="text-link" href="/ventures">
        ventures
      </a>{" "}
      I’m building. Away from the keyboard, I’m usually watching anime or
      reading manga.
    </p>
    <p class="reveal">
      My code is on{" "}
      <a
        class="text-link"
        href="https://github.com/fadhilsaheer"
        target="_blank"
        rel="noopener noreferrer"
      >
        GitHub
      </a>
      , I’m around on{" "}
      <a
        class="text-link"
        href="https://x.com/fadhilsaheer"
        target="_blank"
        rel="noopener noreferrer"
      >
        X
      </a>
      , and my inbox is <EmailCopy />.
    </p>
    <p class="reveal">
      Have something in mind?{" "}
      <a class="text-link" href="/contact">
        Let’s talk
      </a>
      .
    </p>
  </div>
</section>
