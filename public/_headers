# Keep prefetched public pages fresh long enough for client navigation.
# Deployments may take up to one minute to reach an already-open browser.
/
  Cache-Control: public, max-age=60, must-revalidate
/projects/
  Cache-Control: public, max-age=60, must-revalidate
/ventures/
  Cache-Control: public, max-age=60, must-revalidate
/experience/
  Cache-Control: public, max-age=60, must-revalidate
/contact/
  Cache-Control: public, max-age=60, must-revalidate

# Content-hashed build assets change URLs whenever their content changes.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
